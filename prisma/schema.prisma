generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────

enum OutputType {
  IMAGE
  VIDEO
  AUDIO
  MODEL_3D
}

enum GenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

// 产物来源 surface — 拆 surface 不拆 engine：Image 与 LoRA 域共用执行引擎，
// 用本字段区分入口（素材/画廊可按来源筛、统计 LoRA 域产出）。
enum GenerationSourceSurface {
  IMAGE_STUDIO
  LORA_WORKBENCH
  CANVAS
  EDIT
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ExecutionOutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CharacterCardStatus {
  DRAFT
  REFINING
  STABLE
  ARCHIVED
}

enum LoraTrainingStatus {
  QUEUED
  TRAINING
  COMPLETED
  FAILED
  CANCELED
}

enum VideoPipelineStatus {
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum PipelineClipStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum VideoScriptStatus {
  DRAFT
  SCRIPT_READY
  FRAMES_READY
  CLIPS_READY
  COMPLETED
  FAILED
}

/// Surface that owns an assistant chat transcript — one slot per domain.
/// Before 2026-08-08 this was STUDIO + NODE_CANVAS, so image / video / LoRA
/// all shared a single `STUDIO` bucket and their histories were interleaved.
/// Legacy STUDIO rows were remapped to IMAGE_STUDIO (owner's call: keep them,
/// image is the primary entry point).
enum AssistantSurface {
  IMAGE_STUDIO
  VIDEO_STUDIO
  LORA
  NODE_CANVAS
}

enum VideoScriptSceneStatus {
  PENDING
  FRAME_GENERATING
  FRAME_READY
  CLIP_GENERATING
  CLIP_READY
  FAILED
}

// ─── Models ───────────────────────────────────────────────────────

model User {
  id               String   @id @default(uuid())
  clerkId          String   @unique
  email            String   @unique
  username         String?  @unique
  displayName      String?
  avatarUrl        String?
  avatarStorageKey String?
  bannerUrl        String?
  bannerStorageKey String?
  bio              String?  @db.Text
  civitaiToken     String? // AES-256-GCM encrypted Civitai API token
  isPublic         Boolean  @default(true)
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  generations        Generation[]
  userApiKeys        UserApiKey[]
  generationJobs     GenerationJob[]
  apiUsageLedger     ApiUsageLedger[]
  imageAnalyses      ImageAnalysis[]
  arenaMatches       ArenaMatch[]
  stories            Story[]
  projects           Project[]
  characterCards     CharacterCard[]
  likesGiven         UserLike[]              @relation("LikesGiven")
  followsGiven       UserFollow[]            @relation("FollowsGiven")
  followsReceived    UserFollow[]            @relation("FollowsReceived")
  collections        Collection[]
  backgroundCards    BackgroundCard[]
  styleCards         StyleCard[]
  cardRecipes        CardRecipe[]
  recipes            Recipe[]
  voiceCards         VoiceCard[]
  creativePreference UserCreativePreference?
  videoPipelines     VideoPipeline[]
  loraTrainingJobs   LoraTrainingJob[]
  loraAssets         LoraAsset[]
  videoScripts       VideoScript[]
  extractedElements  ExtractedElement[]
  nodeWorkflowProjects NodeWorkflowProject[]
  assistantConversations AssistantConversation[]
  researchRuns       ResearchRun[]

  @@index([username])
  @@index([isDeleted])
}

/// Persisted assistant chat (Node canvas and Studio). Messages are JSON
/// text-only (plus remote media URLs) — never base64 payloads.
model AssistantConversation {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  surface   AssistantSurface
  /// NODE_CANVAS: NodeWorkflowProject.id (weak ref, no FK). STUDIO: null.
  projectId String?
  /// Truncated first user message for list UI.
  title     String?
  /// [{ id?, role, content, createdAt? }]
  messages  Json
  shares    AssistantConversationShare[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, surface, updatedAt(sort: Desc)])
  @@index([projectId])
}

/// Unauthenticated, read-only snapshots shared by an assistant conversation owner.
model AssistantConversationShare {
  id             String              @id @default(uuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tokenHash      String              @unique
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime             @default(now())

  @@index([conversationId])
  @@index([expiresAt])
}

/// 一次检索管线执行（AI 导演内核 · 切片 1 §3.1）。
///
/// 存在的理由是**减幻觉要可审计**：助手说的每个具体事实要能点回原文，
/// 「没搜到」和「源挂了」要是两个可分辨的事实，单源失败要留下痕迹。
/// 证据本体存这里，`AssistantConversation.messages` 里只存 researchRunId。
model ResearchRun {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  surface        AssistantSurface
  /// 弱引用，沿用 AssistantConversation 约定（无 FK）。
  projectId      String?
  conversationId String?
  /// find_lora | analyze_character | study_style | review_shot | fact_lookup
  goal           String
  query          String           @db.Text
  /// succeeded | no_evidence | failed | quota_exceeded
  /// ⚠「没搜到」（no_evidence）和「搜挂了」（failed）是两个事实，不许合并。
  status         String
  /// 有没有拿到任何可引用的证据 —— UI 的「未取得联网证据」badge 读它。
  grounded       Boolean
  /// EvidenceItem[]（见 src/types/research.ts）
  evidence       Json
  /// 每条带 basis: source|observation|inference|unknown + evidenceRefs
  conclusions    Json?
  /// 源级回执 [{ sourceId, status, count, tookMs, error?, via? }]。
  /// 部分成功是常态 —— 单源静默失败不允许，所以逐源落库而不是只存一个总状态。
  perSource      Json
  model          String?
  error          String?          @db.Text
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  /// 每日配额直接 count 这个索引（不塞 ApiUsageLedger —— 形状不合）。
  @@index([userId, createdAt(sort: Desc)])
  @@index([conversationId])
}

/// Node Studio workflow project — persists the React Flow canvas state
/// (nodes + edges + per-node data) per user so a workflow survives across
/// devices and browser refreshes. Treated as opaque JSON in the DB; shape
/// is validated server-side via NodeWorkflowStateSchema (Zod) before write.
model NodeWorkflowProject {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  /// Full workflow snapshot: { nodes: [...], edges: [...] }
  state        Json
  /// Last time the user opened or saved this project. Highest lastActiveAt
  /// among the user's projects becomes the default open project.
  lastActiveAt DateTime @default(now())
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, isDeleted, lastActiveAt(sort: Desc)])
}

model Project {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?   @db.Text
  parentId    String?
  parent      Project?  @relation("ProjectTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Project[] @relation("ProjectTree")
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  generations     Generation[]
  characterCards  CharacterCard[]
  backgroundCards BackgroundCard[]
  styleCards      StyleCard[]
  cardRecipes     CardRecipe[]

  @@index([userId, isDeleted, updatedAt(sort: Desc)])
  @@index([userId, parentId, isDeleted, updatedAt(sort: Desc)])
}

model UserApiKey {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId        String
  adapterType    String
  providerConfig Json
  label          String
  encryptedKey   String
  maskedKey      String   @default("****")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, adapterType, modelId])
  @@index([userId, modelId, adapterType])
  // Hot path for `findActiveKeyForAdapter` — picks the most recent active key
  // for a given user × adapter without touching modelId.
  @@index([userId, adapterType, isActive, createdAt(sort: Desc)])
  // Hot path for `listUserApiKeys` — returns the full list newest first.
  @@index([userId, createdAt(sort: Desc)])
}

model Generation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // ── 輸出媒體 ──────────────────────────────────────────────────
  outputType OutputType       @default(IMAGE)
  status     GenerationStatus @default(COMPLETED)
  url        String // R2 永久 URL
  storageKey String // R2 bucket 內的文件路徑
  mimeType   String           @default("image/png")

  // ── 圖片衍生素材（列表 / 詳情預覽）───────────────────────────────
  thumbnailUrl        String?
  thumbnailStorageKey String?
  previewUrl          String?
  previewStorageKey   String?

  // 圖片 / 影格尺寸
  width  Int @default(1024)
  height Int @default(1024)

  // 視頻專用（圖片留 null）
  duration Float? // 秒數，例如 5.0

  // ── 3D 專用（其他媒體留 null）────────────────────────────────────
  // url / storageKey 對 MODEL_3D 存的是 poster PNG（客戶端 toBlob 截圖回填），
  // 真正的 GLB 文件存在 modelUrl / modelStorageKey。
  modelUrl        String? // R2 永久 URL（GLB 文件）
  modelStorageKey String? // R2 bucket 內的 GLB 文件路徑

  // ── 參考圖片 ────────────────────────────────────────────────────
  referenceImageUrl String? // R2 永久 URL（用戶上傳的參考圖）

  // ── Prompt ────────────────────────────────────────────────────
  prompt         String  @db.Text
  negativePrompt String? @db.Text

  // ── 模型資訊 ──────────────────────────────────────────────────
  model    String // 對應 AI_MODELS enum 的值
  provider String // "HuggingFace" | "SiliconFlow" | "Seedance" 等

  // ── API usage ────────────────────────────────────────────────
  requestCount     Int     @default(1)
  isFreeGeneration Boolean @default(false)

  // ── 可見性 ────────────────────────────────────────────────────
  isPublic       Boolean @default(false)
  isPromptPublic Boolean @default(false)
  isFeatured     Boolean @default(false)

  // ── 關聯 ──────────────────────────────────────────────────────
  userId          String?
  user            User?                     @relation(fields: [userId], references: [id])
  projectId       String?
  project         Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  characterCardId String?
  characterCard   CharacterCard?            @relation(fields: [characterCardId], references: [id], onDelete: SetNull)
  characterCards  GenerationCharacterCard[]
  cardRecipeId    String?
  cardRecipe      CardRecipe?               @relation(fields: [cardRecipeId], references: [id], onDelete: SetNull)
  recipeSnapshot  Json?

  // ── 来源血缘 ──────────────────────────────────────────────────
  // sourceSurface 是顶层可查询列（默认 IMAGE_STUDIO；存量不回填）。
  // loraLineage 记录 LoRA 域生成用到的 loraAssetId / scale / recipe 来源（变长，不索引）。
  sourceSurface GenerationSourceSurface @default(IMAGE_STUDIO)
  loraLineage   Json?

  // ── B0: Generation Snapshot ────────────────────────────────────
  snapshot      Json? // Full input parameter snapshot
  evaluation    Json? // GenerationEvaluation — written by generation-evaluator.service
  runGroupId    String? // Groups compare/variant runs
  runGroupType  String  @default("single") // "single" | "compare" | "variant"
  runGroupIndex Int     @default(0) // Position within group (0-based)
  isWinner      Boolean @default(false) // Winner flag for compare mode
  seed          BigInt? // Seed for reproducibility

  generationJob     GenerationJob?     @relation("GenerationToJob")
  apiUsageLedger    ApiUsageLedger[]   @relation("GenerationToUsage")
  arenaEntries      ArenaEntry[]
  storyPanels       StoryPanel[]
  likes             UserLike[]
  collectionItems   CollectionItem[]
  videoPipeline     VideoPipeline?
  extractedElements ExtractedElement[] @relation("ExtractedElementSource")

  @@index([userId])
  @@index([isPublic, createdAt(sort: Desc)])
  @@index([userId, isFeatured, isPublic, createdAt(sort: Desc)])
  @@index([userId, isFreeGeneration, createdAt(sort: Desc)])
  @@index([outputType, isPublic, createdAt(sort: Desc)])
  @@index([userId, isPublic, createdAt(sort: Desc)])
  @@index([userId, sourceSurface, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId, projectId, createdAt(sort: Desc)])
  @@index([characterCardId, createdAt(sort: Desc)])
  @@index([runGroupId])
  @@index([prompt(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_generation_prompt_trgm")
}

model GenerationJob {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationId      String?             @unique
  generation        Generation?         @relation("GenerationToJob", fields: [generationId], references: [id], onDelete: SetNull)
  adapterType       String
  provider          String
  modelId           String
  status            GenerationJobStatus @default(QUEUED)
  requestCount      Int                 @default(0)
  prompt            String?             @db.Text
  errorMessage      String?             @db.Text
  errorCode         String?
  providerFailure   Json?
  externalRequestId String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  apiUsageLedger  ApiUsageLedger[] @relation("GenerationJobToUsage")
  executionOutbox ExecutionOutbox?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model ExecutionOutbox {
  id              String                @id @default(uuid())
  generationJobId String                @unique
  generationJob   GenerationJob         @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  kind            String
  status          ExecutionOutboxStatus @default(PENDING)
  payload         Json
  result          Json?
  attemptCount    Int                   @default(0)
  lastError       String?               @db.Text
  leaseExpiresAt  DateTime?
  processedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status, leaseExpiresAt, createdAt(sort: Desc)])
}

model ApiUsageLedger {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationId     String?
  generation       Generation?    @relation("GenerationToUsage", fields: [generationId], references: [id], onDelete: SetNull)
  generationJobId  String?
  generationJob    GenerationJob? @relation("GenerationJobToUsage", fields: [generationJobId], references: [id], onDelete: SetNull)
  adapterType      String
  provider         String
  modelId          String
  requestCount     Int            @default(1)
  inputImageCount  Int            @default(0)
  outputImageCount Int            @default(1)
  width            Int?
  height           Int?
  durationMs       Int?
  wasSuccessful    Boolean        @default(true)
  errorMessage     String?        @db.Text
  createdAt        DateTime       @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([adapterType, modelId, createdAt(sort: Desc)])
  @@index([wasSuccessful, createdAt(sort: Desc)])
}

model FreeTierSlot {
  id        String   @id @default(cuid())
  userId    String
  date      String // YYYY-MM-DD UTC (e.g. "2026-04-25")
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Recipe {
  id                 String     @id @default(cuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  outputType         OutputType @default(IMAGE)
  name               String     @default("")
  userIntent         Json?
  compiledPrompt     String     @db.Text
  negativePrompt     String?    @db.Text
  modelId            String
  provider           String
  params             Json?
  referenceAssets    Json?
  seed               BigInt?
  parentGenerationId String?
  version            Int        @default(1)
  evaluationSummary  Json?
  isDeleted          Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // ── Recipe assets：历史孤儿 migration 已于 2026-06 恢复入库
  //    （prisma/migrations/20260531090000_prompt_core_recipe_assets）。
  coverGenerationId   String?
  coverImageUrl       String?
  favoriteCount       Int        @default(0)
  lastUsedAt          DateTime?
  remixSourceRecipeId String?
  tags                String[]   @default([])
  usageCount          Int        @default(0)
  visibility          String     @default("PRIVATE")

  @@index([userId, isDeleted, createdAt(sort: Desc)])
  @@index([visibility, isDeleted, createdAt(sort: Desc)])
}

model VoiceCard {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                     String
  provider                 String   @default("fish_audio")
  modelId                  String?
  voiceId                  String?
  coverImage               String?  @db.Text
  referenceAudioUrl        String?  @db.Text
  referenceAudioStorageKey String?
  gender                   String?
  age                      String?
  tone                     Json     @default("[]")
  pace                     String   @default("normal")
  pitch                    String?
  pronunciationDictionary  Json     @default("{}")
  /// 收藏公开音色时一并存下的示例音频。与 referenceAudioUrl 严格分开：后者只有
  /// 克隆音色才有，并且被当作「这是不是克隆卡」的判据（声音库的两个 tab 靠它分流），
  /// 往里写公开音色的试听会把收藏卡错分到克隆 tab。
  sampleAudioUrl           String?  @db.Text
  sampleText               String?  @db.Text
  isDeleted                Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([userId, isDeleted, createdAt(sort: Desc)])
}

model UserCreativePreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoriteStyles        Json     @default("[]")
  rejectedStyles        Json     @default("[]")
  preferredModelsByTask Json     @default("{}")
  commonNegativeTags    Json     @default("[]")
  preferredAspectRatios Json     @default("[]")
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@index([userId])
}

model ImageAnalysis {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceImageUrl   String
  sourceStorageKey String
  generatedPrompt  String   @db.Text
  modelUsed        String
  createdAt        DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model ArenaMatch {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt         String       @db.Text
  taskType       String? // 'portrait' | 'landscape' | 'anime' | 'artistic' | 'product' | 'architecture' | 'general'
  aspectRatio    String
  referenceImage String?      @db.Text
  winnerId       String?
  votedAt        DateTime?
  createdAt      DateTime     @default(now())
  entries        ArenaEntry[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([taskType])
}

model ArenaEntry {
  id           String     @id @default(uuid())
  matchId      String
  match        ArenaMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  generationId String
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  modelId      String
  slotIndex    Int
  wasVoted     Boolean    @default(false)

  @@unique([matchId, generationId])
}

model ModelEloRating {
  id          String   @id @default(uuid())
  modelId     String   @unique
  modelFamily String?
  rating      Float    @default(1500)
  matchCount  Int      @default(0)
  winCount    Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([modelFamily, rating(sort: Desc)])
}

model ModelConfig {
  id              String     @id @default(uuid())
  modelId         String     @unique
  externalModelId String
  adapterType     String
  outputType      OutputType @default(IMAGE)
  cost            Int        @default(1)
  available       Boolean    @default(true)
  officialUrl     String?
  timeoutMs       Int?
  qualityTier     String?
  i2vModelId      String?
  videoDefaults   Json?
  providerConfig  Json
  sortOrder       Int        @default(0)
  healthStatus    String?
  lastHealthCheck DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([outputType, available, sortOrder])
}

model Story {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  coverImageId String?
  displayMode  String       @default("scroll")
  isPublic     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  panels       StoryPanel[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([isPublic, createdAt(sort: Desc)])
  @@index([userId, isPublic, createdAt(sort: Desc)])
}

model StoryPanel {
  id           String      @id @default(uuid())
  storyId      String
  story        Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  generationId String?
  generation   Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  orderIndex   Int
  caption      String?     @db.Text
  narration    String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([storyId, orderIndex])
  @@index([storyId, orderIndex])
}

model CharacterCard {
  id                 String              @id @default(uuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId          String?
  project            Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name               String
  description        String?             @db.Text
  sourceImageUrl     String // Primary source image URL (first uploaded)
  sourceStorageKey   String
  sourceImages       Json? // string[] — all uploaded source image URLs (legacy flat)
  sourceImageEntries Json? // SourceImageEntry[] — structured with viewType
  characterPrompt    String              @db.Text
  modelPrompts       Json? // Record<adapterType, optimizedPrompt>
  referenceImages    Json? // string[] — best generation R2 URLs
  attributes         Json? // CharacterAttributes structured data
  loras              Json? // Lora[] — character-specific LoRA models [{url, scale}]
  tags               String[]            @default([])
  status             CharacterCardStatus @default(DRAFT)
  stabilityScore     Float?
  isDeleted          Boolean             @default(false)

  // ── Variant system (folder-like) ────────────────────────────
  parentId     String? // null = root card, set = variant of parent
  parent       CharacterCard?  @relation("CharacterCardVariants", fields: [parentId], references: [id], onDelete: Cascade)
  variants     CharacterCard[] @relation("CharacterCardVariants")
  variantLabel String? // e.g. "Anime Style", "3D Model", "Chibi"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generations      Generation[]
  generationLinks  GenerationCharacterCard[]
  recipesAsChar    CardRecipe[]              @relation("RecipeCharacter")
  loraTrainingJobs LoraTrainingJob[]

  @@index([userId, isDeleted, updatedAt(sort: Desc)])
  @@index([userId, status, isDeleted])
  @@index([parentId, isDeleted, updatedAt(sort: Desc)])
  @@index([userId, projectId, isDeleted, updatedAt(sort: Desc)])
}

model GenerationCharacterCard {
  id              String        @id @default(uuid())
  generationId    String
  generation      Generation    @relation(fields: [generationId], references: [id], onDelete: Cascade)
  characterCardId String
  characterCard   CharacterCard @relation(fields: [characterCardId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([generationId, characterCardId])
  @@index([characterCardId, createdAt(sort: Desc)])
  @@index([generationId])
}

model UserLike {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation("LikesGiven", fields: [userId], references: [id], onDelete: Cascade)
  generationId String
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, generationId])
  @@index([generationId])
  @@index([userId, createdAt(sort: Desc)])
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("FollowsGiven", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("FollowsReceived", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId, createdAt(sort: Desc)])
}

model Collection {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  coverUrl    String?
  isPublic    Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items CollectionItem[]

  @@index([userId, isDeleted, updatedAt(sort: Desc)])
  @@index([isPublic, isDeleted, updatedAt(sort: Desc)])
}

model CollectionItem {
  id           String     @id @default(uuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  generationId String
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  orderIndex   Int        @default(0)
  addedAt      DateTime   @default(now())

  @@unique([collectionId, generationId])
  @@index([collectionId, orderIndex])
  @@index([generationId])
}

// ─── Composable Card System ─────────────────────────────────────

model BackgroundCard {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name             String
  description      String?  @db.Text
  sourceImageUrl   String?
  sourceStorageKey String?
  backgroundPrompt String   @db.Text
  attributes       Json?
  loras            Json? // Lora[] — background-specific LoRA models
  tags             String[] @default([])
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recipesAsBg CardRecipe[] @relation("RecipeBackground")

  @@index([userId, projectId, isDeleted, updatedAt(sort: Desc)])
}

model StyleCard {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name             String
  description      String?  @db.Text
  sourceImageUrl   String?
  sourceStorageKey String?
  stylePrompt      String   @db.Text
  attributes       Json?
  loras            Json? // Lora[] — style-specific LoRA models
  modelId          String? // AI_MODELS enum value (replaces ModelCard)
  adapterType      String? // AI_ADAPTER_TYPES value
  advancedParams   Json? // AdvancedParams (guidance, steps, seed, loras)
  tags             String[] @default([])
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recipesAsStyle CardRecipe[] @relation("RecipeStyle")

  @@index([userId, projectId, isDeleted, updatedAt(sort: Desc)])
}

model CardRecipe {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name             String
  characterCardId  String?
  characterCard    CharacterCard?  @relation("RecipeCharacter", fields: [characterCardId], references: [id], onDelete: SetNull)
  backgroundCardId String?
  backgroundCard   BackgroundCard? @relation("RecipeBackground", fields: [backgroundCardId], references: [id], onDelete: SetNull)
  styleCardId      String?
  styleCard        StyleCard?      @relation("RecipeStyle", fields: [styleCardId], references: [id], onDelete: SetNull)
  freePrompt       String?         @db.Text
  isDeleted        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  generations Generation[]

  @@index([userId, projectId, isDeleted, updatedAt(sort: Desc)])
}

// ─── Long Video Pipeline ────────────────────────────────────────

model VideoPipeline {
  id     String              @id @default(uuid())
  userId String
  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status VideoPipelineStatus @default(RUNNING)

  // Generation parameters (frozen at pipeline creation)
  prompt         String  @db.Text
  modelId        String
  adapterType    String
  aspectRatio    String  @default("16:9")
  resolution     String?
  negativePrompt String? @db.Text

  // Extension method: "native_extend" | "last_frame_chain"
  extensionMethod String @default("native_extend")

  // Target & progress
  targetDurationSec  Int
  currentDurationSec Float @default(0)
  totalClips         Int   @default(1)
  completedClips     Int   @default(0)

  // Final output
  finalVideoUrl   String?
  finalStorageKey String?
  generationId    String?     @unique
  generation      Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  // Reference for character consistency
  characterCardIds  String[] @default([])
  referenceImageUrl String?
  apiKeyId          String?

  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clips VideoPipelineClip[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model VideoPipelineClip {
  id         String             @id @default(uuid())
  pipelineId String
  pipeline   VideoPipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  clipIndex  Int
  status     PipelineClipStatus @default(PENDING)

  // Job tracking
  generationJobId   String?
  externalRequestId String? @db.Text

  // Clip result
  videoUrl     String?
  storageKey   String?
  lastFrameUrl String?
  durationSec  Float?

  // Extension input
  inputVideoUrl String? // For native extend: previous clip's video URL
  inputFrameUrl String? // For last-frame chain: previous clip's last frame

  errorMessage String?   @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([pipelineId, clipIndex])
  @@index([pipelineId, clipIndex])
  @@index([status, createdAt(sort: Desc)])
}

// ─── LoRA Training ────────────────────────────────────────────────

model LoraTrainingJob {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  triggerWord        String
  loraType           String             @default("subject") // "subject" | "style"
  baseModel          String             @default("flux-dev")
  trainingImageKeys  String[] // R2 storage keys
  status             LoraTrainingStatus @default(QUEUED)
  externalTrainingId String? // Replicate training ID
  progress           Float              @default(0) // 0-1
  errorMessage       String?            @db.Text
  loraUrl            String? // Trained LoRA URL
  loraStorageKey     String? // R2 backup key
  createdAt          DateTime           @default(now())
  startedAt          DateTime?
  completedAt        DateTime?

  characterCardId String?
  characterCard   CharacterCard? @relation(fields: [characterCardId], references: [id], onDelete: SetNull)

  loraAsset LoraAsset?

  @@index([userId, status, createdAt(sort: Desc)])
}

// ─── LoRA Asset (reusable, style-code addressable) ────────────────

model LoraAsset {
  id String @id @default(uuid())

  // userId is nullable so curated/platform LoRAs can exist without an owner
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Human-facing label + URL-safe short code for cross-tool sharing
  name      String
  styleCode String @unique // e.g. "pv-ghibli-soft-7k2x"

  source          String @default("trained") // "curated" | "trained" | "imported"
  type            String @default("subject") // "subject" | "style"
  baseModelFamily String @default("flux") // "flux" | "sdxl" | ...
  provider        String @default("fal") // adapter routing hint

  triggerWord      String
  loraUrl          String // direct download URL passed to provider
  storageKey       String? // R2 key (null for curated/external)
  previewImageUrls Json? // string[] — auto-generated preview gallery
  coverImageUrl    String? // single hero image for cards

  defaultScale Float @default(1.0)

  // Civitai-source provenance — populated only for source='imported' rows
  // favorited from the Civitai browser. Persisting these lets "贴近来源图"
  // reconstruct the author/mined source prompt after a reload or via a
  // shared ?style= link, instead of silently degrading to a generic
  // template. Null for trained/curated LoRAs.
  civitaiModelId        Int?
  civitaiModelVersionId Int?
  civitaiFileHashAutoV3 String?
  recommendedPrompt     String? @db.Text

  trainingJobId String?          @unique
  trainingJob   LoraTrainingJob? @relation(fields: [trainingJobId], references: [id], onDelete: SetNull)

  isPublic   Boolean   @default(false)
  usageCount Int       @default(0)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([source, isPublic, createdAt(sort: Desc)])
}

// ─── Video Script (VS1-VS11) ──────────────────────────────────────

model VideoScript {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic           String             @db.Text
  targetDuration  Int // 30 | 60 | 120 (seconds)
  totalScenes     Int // derived from targetDuration
  status          VideoScriptStatus  @default(DRAFT)
  consistencyMode String // 'character_card' | 'first_frame_ref'
  characterCardId String? // required when consistencyMode = 'character_card'
  styleCardId     String? // optional global style
  videoModelId    String // 'seedance-2-fast' | 'kling-pro'
  finalVideoUrl   String?
  scenes          VideoScriptScene[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc)])
}

model VideoScriptScene {
  id                String                 @id @default(cuid())
  scriptId          String
  script            VideoScript            @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  orderIndex        Int
  duration          Int
  cameraShot        String
  action            String                 @db.Text
  dialogue          String?                @db.Text
  transition        String // 'cut' | 'fade' | 'dissolve' (Phase 1 only 'cut')
  frameGenerationId String? // VS10: plain string, no FK
  clipGenerationId  String? // VS10: plain string, no FK
  status            VideoScriptSceneStatus @default(PENDING)
  errorMessage      String?                @db.Text
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([scriptId, orderIndex])
  @@index([scriptId, orderIndex])
  @@index([status, createdAt(sort: Desc)])
}

// ─── Extracted Element (reusable subject/material cutout) ────────
//
// Stores the result of /studio/edit/extract-element runs so the user can drop
// them into future generations as reference material. The cutout PNG lives in
// R2 (extractedStorageKey); the optional sourceGenerationId links back to the
// internal source image when the extract came from an existing Generation,
// otherwise sourceImageUrl alone holds the input reference.

model ExtractedElement {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceGenerationId String?
  sourceGeneration   Generation? @relation("ExtractedElementSource", fields: [sourceGenerationId], references: [id], onDelete: SetNull)
  sourceImageUrl     String      @db.Text

  extractedUrl        String  @db.Text
  extractedStorageKey String
  thumbnailUrl        String? @db.Text
  thumbnailStorageKey String?

  width  Int @default(1024)
  height Int @default(1024)

  name   String
  prompt String  @db.Text
  invert Boolean @default(false)

  provider String // "fal" | "gemini" | "openai"
  modelId  String

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([sourceGenerationId])
}

// ─── Inspiration Prompt (curated public prompt library) ──────────
//
// Public, read-only catalog of curated prompts imported from external
// sources (initially MeiGen-AI-Design's trending-prompts dataset,
// ~1446 entries). Users browse, filter, and "clone to my Recipe" —
// cloning copies the prompt text into a new Recipe owned by the user.
// No userId here; this table is shared infrastructure.
//
// Primary key is the source ID (e.g. an X/Twitter status id) so the
// import script can run idempotently — re-importing upserts in place.

model InspirationPrompt {
  id     String @id // source ID, e.g. "2017928823497453789"
  source String @default("meigen") // origin dataset identifier

  rank       Int      @default(0)
  prompt     String   @db.Text
  author     String // source handle, e.g. "TechieBySA"
  authorName String // display name, e.g. "TechieSA"
  likes      Int      @default(0)
  views      Int      @default(0)
  imageUrl   String   @db.Text
  modelHint  String? // upstream model tag, e.g. "gptimage", "nanobanana"
  categories String[] @default([]) // e.g. ["UI & Graphic"]
  sourceUrl  String   @db.Text // original post URL

  rating      Float?
  score       Float?
  publishedAt DateTime?

  isPublic Boolean @default(true) // soft hide without losing the row

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublic, rank])
  @@index([source])
}


/// L2 陈旧兜底：每个规范化查询只留最近一次成功结果的快照。
///
/// 职责被刻意收窄成一件事——Civitai 搜索子系统不可用时，让搜过的词返回陈
/// 旧数据而不是白屏。它不是通用结果缓存：新鲜请求照常打上游（上游健康时
/// 本来就只要 0.6 秒），这里只在上游失败那一刻才被读出来。
///
/// 有界是硬要求。Neon 免费档整个项目 0.5 GB，一条快照实测 7.6–7.8 KB（12 条
/// LoRA 的完整字段）。CIVITAI_SEARCH_SNAPSHOT_MAX_ENTRIES 配合 lastUsedAt 做
/// LRU 淘汰，稳态占用约 8 MB。
model CivitaiSearchSnapshot {
  /// 规范化查询指纹（search/baseModel/sort/nsfw/type/page/cursor 的 sha256）
  key String @id

  /// CivitaiLoraLibraryResult 整体
  payload Json

  /// 这份快照最后一次成功从上游取到的时刻——UI 的「X 分钟前」用它
  fetchedAt DateTime @default(now())

  /// LRU 淘汰依据：最近一次被读或被写的时刻
  lastUsedAt DateTime @default(now())

  @@index([lastUsedAt])
}

/// L3 本地目录镜像：Civitai 的 LoRA 目录抄一份到本地，让搜索不再依赖上游
/// 搜索子系统的健康度。
///
/// 字段集合由「渲染一条 CivitaiLoraLibraryItem 需要什么」倒推，不是随手挑
/// 的——目标是本地命中的搜索一次上游请求都不发。下载地址不存：实测恒等于
/// `https://civitai.com/api/download/models/{versionId}`（32/32），存了反而
/// 是冗余。
///
/// 容量：单行实测 1,724 B（真数据灌到 6000 行时量的，索引固定开销已摊薄；
/// 1000 行时还是 2,662 B，别用小样本估）。全量 642,554 条 ≈ 1.1 GB，远超
/// Neon 免费档 0.5 GB，所以首灌按 downloadCount 截断在
/// CIVITAI_MIRROR_BACKFILL_LIMIT（5 万 ≈ 85 MB），那里有完整的算术。
/// 截断只是灌数时的一个参数，表结构与同步管线都按全量设计。
model CivitaiLoraMirror {
  /// Civitai 的 model id
  modelId Int @id

  /// 展示用的那个版本（civitai 自己挑的 version，缺失时取 versions[0]）
  versionId   Int
  versionName String?

  name        String
  creator     String?
  category    String?
  /// 该模型所有图片 nsfwLevel 的最大值——三态过滤靠它
  nsfwLevelMax Int     @default(0)
  /// 名字本身命中 NSFW 关键词（safe 档的第二道防线，落库时算好）
  nsfwNamed   Boolean @default(false)

  /// 版本的 baseModel（family 过滤靠它）
  baseModel  String?
  tags       String[] @default([])
  /// version.trainedWords，触发词抽取的输入
  trainedWords String[] @default([])
  /// version.hashData 里的 AutoV3，挂载栈哈希匹配用
  hashAutoV3 String?

  downloadCount  Int @default(0)
  thumbsUpCount  Int @default(0)
  collectedCount Int @default(0)
  commentCount   Int @default(0)

  /// 封面与预览图：只存 CDN 路径两段（id + uuid 目录），完整 URL 由
  /// buildCivitaiSearchImageOriginalUrl 拼，跟搜索路径同一套逻辑
  images Json @default("[]")

  createdAt     DateTime
  /// 增量同步的水位线依据。新模型首发和老模型出新版本都会更新它——
  /// Civitai 的 meilisearch 把它做成了 filterable，等于白送一个
  /// changed-since 接口，增量成本因此与目录总量无关。
  lastVersionAt DateTime
  /// 本轮扫描写入这一行的时刻。收尾时靠它认出「本轮没扫到的行」= 掉出
  /// top N 或已被上游删除的。⚠ 由同步管线的批量 upsert 原生 SQL 显式写
  /// 入，不走 Prisma 客户端——所以这里不能标 @updatedAt（那是客户端行为，
  /// 对原生 SQL 无效，标了就是骗人）。
  syncedAt      DateTime @default(now())

  @@index([downloadCount(sort: Desc)])
  @@index([lastVersionAt])
  @@index([baseModel])
  @@index([nsfwLevelMax])
  /// 名称模糊匹配：pg_trgm 1.6 在这个库上已经装好（2026-08-19 实测），
  /// 不需要额外申请扩展。Civitai 的 meilisearch 是 typo-tolerant 的全文
  /// 匹配，trigram 是本地能给出的最接近的等价物。
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([tags], type: Gin)
}

/// 镜像刷新的进度状态。单行表——用固定 id，不是每次插新行。
///
/// 只有一条管线：把 top N 按下载量整轮重扫一遍，upsert，然后把本轮没扫到
/// 的行删掉。看起来比"增量同步 + 指标刷新 + 删除对账"三条管线粗暴，但
/// **指标刷新本来就绕不开全量扫描**——下载量/点赞数不会更新
/// lastVersionAtUnix，changed-since 信号照不到它们，而它们正是排序依据和
/// top-N 截断线的依据。既然最贵的那条省不掉，合成一条反而更省，也更不会
/// 出现三条管线各自推进到不同进度的中间态。
///
/// 一轮扫完约 100 个上游请求（limit=1000），远超单次 cron 的执行上限，所
/// 以按 cursor 分片续跑：每次 cron 推进若干批，扫到头才收尾。
model CivitaiMirrorSyncState {
  id String @id

  /// 本轮已经推进到的 offset
  cursor Int @default(0)

  /// 本轮开始的时刻。一轮走完后，syncedAt 早于它的行 = 本轮没扫到的行，
  /// 也就是掉出 top N 或已被上游删除的——收尾时清掉。
  passStartedAt DateTime?

  /// 最近一次完整走完的时刻
  lastCompletedAt DateTime?
  /// 最近一次失败的原因，失败要能看见而不是静静重试
  lastError String?

  updatedAt DateTime @updatedAt
}
