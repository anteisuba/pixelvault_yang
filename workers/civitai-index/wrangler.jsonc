{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixelvault-civitai-index",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-14",
  "observability": {
    "enabled": true,
  },
  // 一次搜索要连查 D1 两三次：让 Worker 跑在 D1 旁边，而不是离用户最近的边缘
  // （从东京调时每次往返美东约 150 ms）。
  "placement": {
    "mode": "smart",
  },
  // Civitai LoRA 全量索引（D1 + FTS5）。应用侧经 CIVITAI_INDEX_URL /
  // CIVITAI_INDEX_TOKEN 调 /search；见 docs/references/domains/lora.md。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "civitai-index",
      "database_id": "c789584d-3dec-4ddf-9836-eab9c6767767",
      "migrations_dir": "migrations",
    },
  ],
  "workflows": [
    {
      "name": "pixelvault-civitai-index-sync",
      "binding": "SYNC_WORKFLOW",
      "class_name": "CivitaiIndexSyncWorkflow",
    },
  ],
  // 按意思搜：经 service binding 直接调 semantic-index 的 SemanticIndex 入口（RPC），
  // 不经公网、不用 token。⚠ 首次部署前 semantic-index 要先带着这个入口部署好。
  "services": [
    {
      "binding": "SEMANTIC",
      "service": "pixelvault-semantic-index",
      "entrypoint": "SemanticIndex",
    },
  ],
  // 每天一轮（owner 2026-10-07 定：不做每小时）。19:00 UTC = 日本凌晨 4 点。
  // 每 3 分钟一次「保温」：库闲十几分钟 D1 就要重新醒，第一个打开 LoRA 库的人卡 8–35 秒
  // （2026-10-24～26 线上）。保温只读一行，见 index.ts 的 scheduled。
  "triggers": {
    "crons": ["0 19 * * *", "*/3 * * * *"],
  },
}
