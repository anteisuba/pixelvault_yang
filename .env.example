# ──────────────────────────────────────────────────────────────────────────
# PixelVault — environment template
#
# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).
# Everything here is a placeholder — no real secrets.
#
# ⚠️  TEST-ONLY vs PRODUCTION
# Credentials you put in .env.local for local dev / testing (the E2E test user,
# any provider keys used to exercise the app) must be THROWAWAY / DEV-instance /
# spend-capped. NEVER reuse production API keys or production credentials for
# testing, and never let a test key reach production.
#
# API KEYS — TWO LAYERS (this answers "do API keys go in env?"):
#   1. SYSTEM / PLATFORM keys = the AI provider vars below. Fallback used for
#      free-tier generations + model health checks. PUT THESE IN .env.local to
#      make generation work locally without per-user setup. (Use test keys.)
#   2. USER keys (bring-your-own) = entered in-app via QuickSetupDialog,
#      encrypted with API_KEY_ENCRYPTION_SECRET, stored per-user in the DB.
#      NOT set via env. To test the BYO flow, configure a key in the app for
#      your signed-in (test) user; for E2E, seed it through the api-keys API.
# ──────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────
# Neon 两端点模式（迁移与运行时不共用同一条连接）：
#   DATABASE_URL — 运行时用（src/lib/db.ts 经 @prisma/adapter-pg）。Neon 连接池
#     端点，主机名带 -pooler（如 ep-xxx-pooler.c-4.us-east-1.aws.neon.tech）。
#   DIRECT_URL   — 仅 `prisma migrate`/`db`/`studio` 这类 CLI 命令用（见
#     prisma.config.ts）。Neon 直连端点，主机名**不带** -pooler。两者其余部分
#     （用户名/密码/库名）通常相同，只有主机名差一个 "-pooler"。
#   ⚠ 缺 DIRECT_URL 时 `prisma migrate *` 会在 prisma.config.ts 里大声失败，
#     不会静默退回 DATABASE_URL 的 pooler 端点——PgBouncer 事务池化下迁移用的
#     advisory lock 不可靠。
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# 迁移预演（`npm run preflight:migrations`）用：从运行时那个库开一个即用即弃的
# Neon 分支，把还没应用的迁移在上面真跑一遍再删掉。只在本机用，不进 Vercel。
#   NEON_API_KEY    — Neon 控制台 → Account settings（项目在组织下则是
#     Organization settings）→ API keys → Create new API key。只显示一次。
#   NEON_PROJECT_ID — 项目 Settings → General，或地址栏 /app/projects/<这一段>。
# ⚠ 不必也不该指定 `--parent`：脚本从 DATABASE_URL 的主机名反推该在哪个分支上
#   预演。本项目 Neon 的分支名是**反的**——叫 production 的那个是陈旧库（还是
#   Neon 的默认分支），运行时真正连的库挂在叫 development 的分支上。
NEON_API_KEY=
NEON_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# ── Auth (Clerk) — use a DEVELOPMENT instance locally (pk_test_/sk_test_) ───
# Required. The @clerk/testing visual-regression setup also needs these.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# ── Storage (Cloudflare R2) ─────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_STORAGE_BASE_URL=https://cdn.example.com

# ── Civitai cover image proxy (optional) ────────────────────────────────────
# 公开 LoRA 库封面直连 image.civitai.com；整页并发几十张 → Civitai 按客户端限流
# 回 429/503 → 封面加载失败。设成边缘缓存代理源（Cloudflare Worker，见
# workers/civitai-image-proxy/，自定义域 img.anteisuba.com），浏览器就改从自家源
# 命中缓存加载。未设 = 回退直连（突发加载仍会 429/503）。不带路径、无尾斜杠。
NEXT_PUBLIC_CIVITAI_IMAGE_PROXY_BASE=

# ── Secrets for encrypting user-stored keys/tokens (required for BYO flow) ──
# 32-byte hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_SECRET=
CIVITAI_TOKEN_SECRET=

# ── AI provider SYSTEM keys (layer 1 above — optional fallback; TEST keys) ──
HF_API_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
FAL_API_KEY=            # platform-keys reads this; the fal SDK also reads FAL_KEY
REPLICATE_API_TOKEN=
NOVELAI_API_TOKEN=
VOLCENGINE_API_KEY=
RUNWAYML_API_SECRET=    # alt: RUNWAY_API_KEY
CIVITAI_API_TOKEN=
FISH_AUDIO_VOICE_LIBRARY_API_KEY=
AI_GATEWAY_API_KEY=
RUNPOD_KEY=             # Comfy Runner (platform-only, no BYOK) — pairs with NEXT_PUBLIC_FF_COMFY_RUNNER

# ── Web research (Node Studio "参考作品" / reference-research turn) ──────────
# SERPER_API_KEY: Google search via serper.dev — enables LIVE web search in the
#   assistant's research turn (best Chinese / Bilibili coverage). Without it,
#   research falls back to provider grounding (Gemini/OpenAI) or model knowledge.
# JINA_API_KEY: optional — Jina Reader (r.jina.ai) reads URLs anonymously; a key
#   only raises rate limits.
SERPER_API_KEY=
JINA_API_KEY=

# ── Infra (optional for local dev) ──────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
EXECUTION_WORKER_BASE_URL=
INTERNAL_CALLBACK_SECRET=
CRON_SECRET=
HEALTH_CHECK_TOKEN=
ADMIN_USER_IDS=         # comma-separated Clerk user IDs
VERCEL_PROTECTION_BYPASS=

# ── Observability ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# ── Feature flags (NEXT_PUBLIC_FF_*) — "true"/"false", *_ROLLOUT = 0-100 ────
# Comfy Runner (RunPod ComfyUI recipe clones) — server side also needs
# RUNPOD_KEY; see docs/plans/comfy-runner-HANDOFF-2026-07.md
NEXT_PUBLIC_FF_COMFY_RUNNER=false
NEXT_PUBLIC_FF_IMAGE_EDITING=false
NEXT_PUBLIC_FF_MULTI_COMPARE=false
NEXT_PUBLIC_FF_SERIES_MODE=false
NEXT_PUBLIC_FF_SMART_PROMPT=false
NEXT_PUBLIC_FF_SMART_PROMPT_ROLLOUT=0
NEXT_PUBLIC_FF_VARIANT_GEN=false
NEXT_PUBLIC_FF_VARIANT_GEN_ROLLOUT=0
NEXT_PUBLIC_ENABLE_VERCEL_TOOLBAR=false

# ── E2E / visual regression (Playwright) ────────────────────────────────────
# ⚠️ TEST-ONLY: dedicated Clerk DEVELOPMENT-instance test user (email+password).
# Never a real/production account. Used by e2e/auth.setup.ts to save an
# authenticated storageState for studio visual specs.
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=
# Local E2E-only escape hatch. Never enable in preview or production.
AUTH_BYPASS_FOR_E2E=false

# Production fails closed when omitted. Set true only after Clerk
# Restricted/Waitlist + Bot Protection and platform budget alerts are ready.
PLATFORM_GENERATION_ENABLED=false
