generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────

enum OutputType {
  IMAGE
  VIDEO
  AUDIO
  MODEL_3D
}

enum GenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

// 产物来源 surface — 拆 surface 不拆 engine：Image 与 LoRA 域共用执行引擎，
// 用本字段区分入口（素材/画廊可按来源筛、统计 LoRA 域产出）。
enum GenerationSourceSurface {
  IMAGE_STUDIO
  LORA_WORKBENCH
  CANVAS
  EDIT
}

/// 上下文卡是哪一类（`ContextCard.kind`）。
///
/// ⚠ 三档是**同一件事的三个对象**：一张账号级、可 @ 注入、可常挂的持久上下文。
/// ⛔ 不拆三张表 —— 它们的列一模一样（名字 / 摘要 / 正文 / 参考图 / 硬否定 /
/// 常挂域），拆开只会让「列出这个用户的全部卡」变成三次查询再归并。
/// 一张上下文卡**进没进用户的长期记忆**（v2 §8.2）。
///
/// ⭐ 只有两态，且默认是**已确认**：存量的每一行都是用户自己在设置里写下的卡，
/// 加这一列不改变它们的语义。
/// ⚠ `PROPOSED` = 助手提议、用户还没点头的草稿：它**不进系统提示、也不进
/// `list_context_cards` 的名单**（不然模型会读到自己刚编的东西，还以为是用户的
/// 设定）。⛔ 这一列不是给助手的「先写了再说」后门 —— 服务端在提议那一跳一行库
/// 都不写（v2 §8.1），它存在的意义是「用户在面板上没点、后来在设置里补点」这条
/// 路走得通。
enum ContextCardStatus {
  /// 助手提议的草稿，等用户在待确认区点头。
  PROPOSED
  /// 用户认下的卡 —— 可 @ 注入、可常挂。
  CONFIRMED
}

enum ContextCardKind {
  /// 角色：外貌 / 服饰 / 性格，正文进系统提示，参考图供 `mount_reference` 直接挂。
  CHARACTER
  /// 风格：画风规则，落到 `set_prompt` 的约束上。
  STYLE
  /// 品牌：品牌规范（配色、字体、禁用元素），与风格同一条注入路径。
  BRAND
}

/// 一条项目规则**是哪一种**（assistant-shell-v2 §9.3）。
///
/// ⚠ 来源白 / 黑名单复用这张表而不是另开一张：它已经有 userId / scope / source
/// 三个维度，而来源名单要的正是这三个，且「这个项目只信官方设定集」本来就是
/// 用户心里的一条项目规则。
enum ProjectRuleKind {
  /// 普通项目规则（v1 现状）—— text 是规则原文。
  NOTE
  /// 来源白名单 —— text 是一个来源 id（web / wiki / bilibili / danbooru）或域名。
  SOURCE_ALLOW
  /// 来源黑名单 —— text 同上，任何时候都过滤掉。
  SOURCE_DENY
}

/// 一条项目规则是谁记下来的（规则薄卡上那行「来源：××」）。
enum ProjectRuleSource {
  /// 助手在对话里通过 add_project_rule 记的。
  ASSISTANT
  /// 用户自己写的。
  CREATOR
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ExecutionOutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CharacterCardStatus {
  DRAFT
  REFINING
  STABLE
  ARCHIVED
}

enum LoraTrainingStatus {
  QUEUED
  TRAINING
  COMPLETED
  FAILED
  CANCELED
}

enum VideoPipelineStatus {
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum PipelineClipStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum VideoScriptStatus {
  DRAFT
  SCRIPT_READY
  FRAMES_READY
  CLIPS_READY
  COMPLETED
  FAILED
}

/// Surface that owns an assistant chat transcript — one slot per domain.
/// Before 2026-08-08 this was STUDIO + NODE_CANVAS, so image / video / LoRA
/// all shared a single `STUDIO` bucket and their histories were interleaved.
/// Legacy STUDIO rows were remapped to IMAGE_STUDIO (owner's call: keep them,
/// image is the primary entry point).
enum AssistantSurface {
  IMAGE_STUDIO
  VIDEO_STUDIO
  LORA
  NODE_CANVAS
}

enum VideoScriptSceneStatus {
  PENDING
  FRAME_GENERATING
  FRAME_READY
  CLIP_GENERATING
  CLIP_READY
  FAILED
}

// ─── Models ───────────────────────────────────────────────────────

model User {
  id               String   @id @default(uuid())
  clerkId          String   @unique
  email            String   @unique
  username         String?  @unique
  displayName      String?
  avatarUrl        String?
  avatarStorageKey String?
  bannerUrl        String?
  bannerStorageKey String?
  bio              String?  @db.Text
  civitaiToken     String? // AES-256-GCM encrypted Civitai API token
  isPublic         Boolean  @default(true)
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  generations            Generation[]
  userApiKeys            UserApiKey[]
  generationJobs         GenerationJob[]
  apiUsageLedger         ApiUsageLedger[]
  imageAnalyses          ImageAnalysis[]
  stories                Story[]
  projects               Project[]
  characterCards         CharacterCard[]
  likesGiven             UserLike[]              @relation("LikesGiven")
  followsGiven           UserFollow[]            @relation("FollowsGiven")
  followsReceived        UserFollow[]            @relation("FollowsReceived")
  collections            Collection[]
  backgroundCards        BackgroundCard[]
  styleCards             StyleCard[]
  cardRecipes            CardRecipe[]
  recipes                Recipe[]
  voiceCards             VoiceCard[]
  creativePreference     UserCreativePreference?
  videoPipelines         VideoPipeline[]
  loraTrainingJobs       LoraTrainingJob[]
  loraAssets             LoraAsset[]
  videoScripts           VideoScript[]
  extractedElements      ExtractedElement[]
  nodeWorkflowProjects   NodeWorkflowProject[]
  assistantConversations AssistantConversation[]
  researchRuns           ResearchRun[]
  voiceRooms             VoiceRoom[]
  assistantPersona       AssistantPersona?
  projectRules           ProjectRule[]
  contextCards           ContextCard[]
  assistantMemories      AssistantMemory[]

  @@index([username])
  @@index([isDeleted])
}

/// Persisted assistant chat (Node canvas and Studio). Messages are JSON
/// text-only (plus remote media URLs) — never base64 payloads.
model AssistantConversation {
  id        String                       @id @default(uuid())
  userId    String
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  surface   AssistantSurface
  /// NODE_CANVAS: NodeWorkflowProject.id (weak ref, no FK). STUDIO: null.
  projectId String?
  /// Truncated first user message for list UI.
  title     String?
  /// [{ id?, role, content, createdAt? }]
  messages  Json
  /// 每轮结账的结论记录（assistant-shell-v2 §7.2）：
  /// [{ roundIndex, createdAt, facts[], decisions[], todos[], evidenceRefs[], editedByUser? }]
  ///
  /// ⚠ 证据**正文不在这里**（它在 `ResearchRun.evidence`，§7.3），这一列只装
  /// `#e12` 形态的编号。同列存正文的代价与 `messages` 那条一字不差：每次读写
  /// 会话都拖着几十 KB 走，而同一份证据会在历史里复制 N 份。
  /// ⚠ 与会话同生共死，所以是同表的一列而不是一张侧表（§7.4 四条判据）。
  rounds    Json                         @default("[]")
  shares    AssistantConversationShare[]
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@index([userId, surface, updatedAt(sort: Desc)])
  @@index([projectId])
}

/// Unauthenticated, read-only snapshots shared by an assistant conversation owner.
model AssistantConversationShare {
  id             String                @id @default(uuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tokenHash      String                @unique
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime              @default(now())

  @@index([conversationId])
  @@index([expiresAt])
}

/// 一次检索管线执行（AI 导演内核 · 切片 1 §3.1）。
///
/// 存在的理由是**减幻觉要可审计**：助手说的每个具体事实要能点回原文，
/// 「没搜到」和「源挂了」要是两个可分辨的事实，单源失败要留下痕迹。
/// 证据本体存这里，`AssistantConversation.messages` 里只存 researchRunId。
model ResearchRun {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  surface        AssistantSurface
  /// 弱引用，沿用 AssistantConversation 约定（无 FK）。
  projectId      String?
  conversationId String?
  /// find_lora | analyze_character | study_style | review_shot | fact_lookup
  goal           String
  query          String           @db.Text
  /// succeeded | no_evidence | failed | quota_exceeded
  /// ⚠「没搜到」（no_evidence）和「搜挂了」（failed）是两个事实，不许合并。
  status         String
  /// 有没有拿到任何可引用的证据 —— UI 的「未取得联网证据」badge 读它。
  grounded       Boolean
  /// EvidenceItem[]（见 src/types/research.ts）
  evidence       Json
  /// 每条带 basis: source|observation|inference|unknown + evidenceRefs
  conclusions    Json?
  /// 源级回执 [{ sourceId, status, count, tookMs, error?, via? }]。
  /// 部分成功是常态 —— 单源静默失败不允许，所以逐源落库而不是只存一个总状态。
  perSource      Json
  model          String?
  error          String?          @db.Text
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  /// 每日配额直接 count 这个索引（不塞 ApiUsageLedger —— 形状不合）。
  @@index([userId, createdAt(sort: Desc)])
  @@index([conversationId])
}

/// Node Studio workflow project — persists the React Flow canvas state
/// (nodes + edges + per-node data) per user so a workflow survives across
/// devices and browser refreshes. Treated as opaque JSON in the DB; shape
/// is validated server-side via NodeWorkflowStateSchema (Zod) before write.
model NodeWorkflowProject {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  /// Full workflow snapshot: { nodes: [...], edges: [...] }
  state        Json
  /// Last time the user opened or saved this project. Highest lastActiveAt
  /// among the user's projects becomes the default open project.
  lastActiveAt DateTime @default(now())
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, isDeleted, lastActiveAt(sort: Desc)])
}

model Project {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?   @db.Text
  parentId    String?
  parent      Project?  @relation("ProjectTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Project[] @relation("ProjectTree")
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  generations     Generation[]
  characterCards  CharacterCard[]
  backgroundCards BackgroundCard[]
  styleCards      StyleCard[]
  cardRecipes     CardRecipe[]

  @@index([userId, isDeleted, updatedAt(sort: Desc)])
  @@index([userId, parentId, isDeleted, updatedAt(sort: Desc)])
}

model UserApiKey {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId        String
  adapterType    String
  providerConfig Json
  label          String
  encryptedKey   String
  maskedKey      String   @default("****")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, adapterType, modelId])
  @@index([userId, modelId, adapterType])
  // Hot path for `findActiveKeyForAdapter` — picks the most recent active key
  // for a given user × adapter without touching modelId.
  @@index([userId, adapterType, isActive, createdAt(sort: Desc)])
  // Hot path for `listUserApiKeys` — returns the full list newest first.
  @@index([userId, createdAt(sort: Desc)])
}

model Generation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // ── 輸出媒體 ──────────────────────────────────────────────────
  outputType OutputType       @default(IMAGE)
  status     GenerationStatus @default(COMPLETED)
  url        String // R2 永久 URL
  storageKey String // R2 bucket 內的文件路徑
  mimeType   String           @default("image/png")

  // ── 圖片衍生素材（列表 / 詳情預覽）───────────────────────────────
  thumbnailUrl        String?
  thumbnailStorageKey String?
  previewUrl          String?
  previewStorageKey   String?

  // 圖片 / 影格尺寸
  width  Int @default(1024)
  height Int @default(1024)

  // 視頻專用（圖片留 null）
  duration Float? // 秒數，例如 5.0

  // ── 3D 專用（其他媒體留 null）────────────────────────────────────
  // url / storageKey 對 MODEL_3D 存的是 poster PNG（客戶端 toBlob 截圖回填），
  // 真正的 GLB 文件存在 modelUrl / modelStorageKey。
  modelUrl        String? // R2 永久 URL（GLB 文件）
  modelStorageKey String? // R2 bucket 內的 GLB 文件路徑

  // ── 參考圖片 ────────────────────────────────────────────────────
  referenceImageUrl String? // R2 永久 URL（用戶上傳的參考圖）

  // ── Prompt ────────────────────────────────────────────────────
  prompt         String  @db.Text
  negativePrompt String? @db.Text

  // ── 模型資訊 ──────────────────────────────────────────────────
  model    String // 對應 AI_MODELS enum 的值
  provider String // "HuggingFace" | "SiliconFlow" | "Seedance" 等

  // ── API usage ────────────────────────────────────────────────
  requestCount     Int     @default(1)
  isFreeGeneration Boolean @default(false)

  // ── 可見性 ────────────────────────────────────────────────────
  isPublic       Boolean @default(false)
  isPromptPublic Boolean @default(false)
  isFeatured     Boolean @default(false)

  // ── 關聯 ──────────────────────────────────────────────────────
  userId          String?
  user            User?                     @relation(fields: [userId], references: [id])
  projectId       String?
  project         Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  characterCardId String?
  characterCard   CharacterCard?            @relation(fields: [characterCardId], references: [id], onDelete: SetNull)
  characterCards  GenerationCharacterCard[]
  cardRecipeId    String?
  cardRecipe      CardRecipe?               @relation(fields: [cardRecipeId], references: [id], onDelete: SetNull)
  recipeSnapshot  Json?

  // ── 来源血缘 ──────────────────────────────────────────────────
  // sourceSurface 是顶层可查询列（默认 IMAGE_STUDIO；存量不回填）。
  // loraLineage 记录 LoRA 域生成用到的 loraAssetId / scale / recipe 来源（变长，不索引）。
  sourceSurface GenerationSourceSurface @default(IMAGE_STUDIO)
  loraLineage   Json?

  // ── 产物序号 ──────────────────────────────────────────────────
  // 用户内递增的真计数器（切片 N1 改序号语义）：`图_012` 就是这个用户的第 12 件。
  // ⚠ 可空是**故意**的，两个理由：
  //   · 迁移分两步 —— 先加空列（有存量行的表上一定成功），同一迁移里再回填；
  //   · 匿名行（userId 为空）没有「第几件」可言，永远留 null，名字只带摘要。
  // ⛔ 不加 unique：撞号由写入侧的取号事务避免（见 generation.service.ts），
  //    唯一索引一旦有存量重复就会炸掉整个生产构建（见 migration-safety.test.ts）。
  seq Int?

  // ── B0: Generation Snapshot ────────────────────────────────────
  snapshot      Json? // Full input parameter snapshot
  evaluation    Json? // GenerationEvaluation — written by generation-evaluator.service
  runGroupId    String? // Groups compare/variant runs
  runGroupType  String  @default("single") // "single" | "compare" | "variant"
  runGroupIndex Int     @default(0) // Position within group (0-based)
  isWinner      Boolean @default(false) // Winner flag for compare mode
  seed          BigInt? // Seed for reproducibility

  generationJob     GenerationJob?     @relation("GenerationToJob")
  apiUsageLedger    ApiUsageLedger[]   @relation("GenerationToUsage")
  storyPanels       StoryPanel[]
  likes             UserLike[]
  collectionItems   CollectionItem[]
  videoPipeline     VideoPipeline?
  extractedElements ExtractedElement[] @relation("ExtractedElementSource")
  layers            GenerationLayer[]  @relation("GenerationLayers")

  @@index([userId])
  @@index([userId, seq])
  @@index([isPublic, createdAt(sort: Desc)])
  @@index([userId, isFeatured, isPublic, createdAt(sort: Desc)])
  @@index([userId, isFreeGeneration, createdAt(sort: Desc)])
  @@index([outputType, isPublic, createdAt(sort: Desc)])
  @@index([userId, isPublic, createdAt(sort: Desc)])
  @@index([userId, sourceSurface, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId, projectId, createdAt(sort: Desc)])
  @@index([characterCardId, createdAt(sort: Desc)])
  @@index([runGroupId])
  @@index([prompt(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_generation_prompt_trgm")
}

model GenerationJob {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationId      String?             @unique
  generation        Generation?         @relation("GenerationToJob", fields: [generationId], references: [id], onDelete: SetNull)
  adapterType       String
  provider          String
  modelId           String
  status            GenerationJobStatus @default(QUEUED)
  requestCount      Int                 @default(0)
  prompt            String?             @db.Text
  errorMessage      String?             @db.Text
  errorCode         String?
  providerFailure   Json?
  externalRequestId String?
  providerJobId     String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  apiUsageLedger  ApiUsageLedger[] @relation("GenerationJobToUsage")
  executionOutbox ExecutionOutbox?
  voiceLines      VoiceLine[]      @relation("VoiceLineJob")

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model ExecutionOutbox {
  id              String                @id @default(uuid())
  generationJobId String                @unique
  generationJob   GenerationJob         @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  kind            String
  status          ExecutionOutboxStatus @default(PENDING)
  payload         Json
  result          Json?
  attemptCount    Int                   @default(0)
  lastError       String?               @db.Text
  leaseExpiresAt  DateTime?
  processedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status, leaseExpiresAt, createdAt(sort: Desc)])
}

model ApiUsageLedger {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationId     String?
  generation       Generation?    @relation("GenerationToUsage", fields: [generationId], references: [id], onDelete: SetNull)
  generationJobId  String?
  generationJob    GenerationJob? @relation("GenerationJobToUsage", fields: [generationJobId], references: [id], onDelete: SetNull)
  adapterType      String
  provider         String
  modelId          String
  requestCount     Int            @default(1)
  inputImageCount  Int            @default(0)
  outputImageCount Int            @default(1)
  width            Int?
  height           Int?
  durationMs       Int?
  wasSuccessful    Boolean        @default(true)
  errorMessage     String?        @db.Text
  createdAt        DateTime       @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([adapterType, modelId, createdAt(sort: Desc)])
  @@index([wasSuccessful, createdAt(sort: Desc)])
}

model FreeTierSlot {
  id        String   @id @default(cuid())
  userId    String
  date      String // YYYY-MM-DD UTC (e.g. "2026-04-25")
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Recipe {
  id                 String     @id @default(cuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  outputType         OutputType @default(IMAGE)
  name               String     @default("")
  userIntent         Json?
  compiledPrompt     String     @db.Text
  negativePrompt     String?    @db.Text
  modelId            String
  provider           String
  params             Json?
  referenceAssets    Json?
  seed               BigInt?
  parentGenerationId String?
  version            Int        @default(1)
  evaluationSummary  Json?
  isDeleted          Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // ── Recipe assets：历史孤儿 migration 已于 2026-06 恢复入库
  //    （prisma/migrations/20260531090000_prompt_core_recipe_assets）。
  coverGenerationId   String?
  coverImageUrl       String?
  favoriteCount       Int       @default(0)
  lastUsedAt          DateTime?
  remixSourceRecipeId String?
  tags                String[]  @default([])
  usageCount          Int       @default(0)
  visibility          String    @default("PRIVATE")

  @@index([userId, isDeleted, createdAt(sort: Desc)])
  @@index([visibility, isDeleted, createdAt(sort: Desc)])
}

model VoiceCard {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                     String
  provider                 String   @default("fish_audio")
  modelId                  String?
  voiceId                  String?
  coverImage               String?  @db.Text
  referenceAudioUrl        String?  @db.Text
  referenceAudioStorageKey String?
  gender                   String?
  age                      String?
  tone                     Json     @default("[]")
  pace                     String   @default("normal")
  pitch                    String?
  pronunciationDictionary  Json     @default("{}")
  /// 收藏公开音色时一并存下的示例音频。与 referenceAudioUrl 严格分开：后者只有
  /// 克隆音色才有，并且被当作「这是不是克隆卡」的判据（声音库的两个 tab 靠它分流），
  /// 往里写公开音色的试听会把收藏卡错分到克隆 tab。
  sampleAudioUrl           String?  @db.Text
  sampleText               String?  @db.Text
  isDeleted                Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  characterCards CharacterCard[]

  @@index([userId, isDeleted, createdAt(sort: Desc)])
}

/// 配音间的一场戏。左列一个房间一行，各自带班底 / 底垫 / 台词。
///
/// 「一场戏 = 一个会话」是这个域的核心比喻：房间不是文件夹，是聊天室。
model VoiceRoom {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// null = 未命名房间（左列灰字显示）。房间不强制命名——先开口，再起名。
  name String?

  /// 班底 = 这个房间里可以开口的人，**有序**。每项形如
  /// `{ id, kind, voiceCardId?, name, coverImage? }`，kind ∈ voice | sfx | bgm。
  ///
  /// 用 Json 而不是关联表：班底是房间的一个属性，不是能被独立检索的实体，
  /// 而且顺序有意义（输入行头像的排列就是它）——Json 数组天然带顺序，关联表
  /// 还得再补一个 order 列。「哪些房间用了这个音色」当前没有需求，等真有了
  /// 再拆表（届时直接改，不留兼容层）。
  cast Json @default("[]")

  /// 配乐底垫 `{ generationId, enabled, gainDb }`。房间级，**不进聊天流** ——
  /// 音乐跨整场，做成气泡就是在时间轴上撒谎。null = 这场戏没有配乐。
  bed Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines VoiceLine[]

  @@index([userId, updatedAt(sort: Desc)])
}

/// 一条台词 = 聊天流里的一个气泡 = 一次生成。
model VoiceLine {
  id     String    @id @default(cuid())
  roomId String
  room   VoiceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// 聊天流顺序，也是「合成整场」的拼接顺序。
  order Int

  /// 指向 `VoiceRoom.cast` 里某一项的 id。⚠ Json 内的 id 没有外键保护：说话人
  /// 被移出班底后这里会悬空，所以渲染**不依赖**它——名字和头像在下面自带快照，
  /// 它只用来回答「点这条能不能跳回那个说话人」。
  speakerId String

  /// voice | sfx —— bgm 不会成为台词（它是房间级底垫）。音效条的样式与人声不同
  /// （虚线胶囊），渲染要靠它分流。
  speakerKind String @default("voice")

  /// 说话人**快照**。音色卡删了、班底改了，这条台词仍然显示得出「谁说的」——
  /// 聊天记录是既成事实，不该因为班底变动而失忆。
  speakerName  String
  speakerCover String? @db.Text

  /// 净台词：情感括号已剥离（「（耳语）别回头」存的是「别回头」）。
  /// 送给 provider 的完整提示词在 Generation.snapshot.providerPrompt 里。
  text String @db.Text

  /// AUDIO_EMOTION 之一；null = 自动（不注入括号提示词，交给模型自己判断）。
  emotion String?

  /// 这条台词最近一次生成任务。
  ///
  /// ⚠ 存的是 **jobId 而不是 generationId**：音频生成是异步的，「正在开口」
  /// 和「失败了」都是要显示的状态，而它们只活在 GenerationJob 上。存
  /// generationId 的话生成中就没有落点，刷新页面这条台词会变成一个空气泡。
  /// 声音本体走 `job.generation` 一次 include 取到，不是 N+1。
  ///
  /// 重录是**覆盖**这个字段（owner 2026-08-29 拍板：剧本视图不做，多版本取舍
  /// 没有消费者）。被换下来的 Generation 不删——它是用户资产，留在素材库里。
  jobId String?
  job   GenerationJob? @relation("VoiceLineJob", fields: [jobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, order])
}

model UserCreativePreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoriteStyles        Json     @default("[]")
  rejectedStyles        Json     @default("[]")
  preferredModelsByTask Json     @default("{}")
  commonNegativeTags    Json     @default("[]")
  preferredAspectRatios Json     @default("[]")
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@index([userId])
}

/// 助手人设（`docs/references/pages/assistant-shell.md` §8）——用户**显式声明**
/// 的「这个助手是谁、怎么说话」，一个用户一份，四域共用。
///
/// ⛔ 有意不并进 `UserCreativePreference`：那张表是系统**学出来**的创作偏好
/// （五个字段全 Json、由行为推断并覆写），而这里每个字段都是有限枚举或短字符串，
/// 该是列不是 Json；两者的读写时机、所有权、能否被系统改写三条全不同。
/// ⛔ 也不往 `User` 加列（全仓最热的表）：1:1 侧表按需 join，**缺行就用代码默认值**
/// `ASSISTANT_PERSONA_DEFAULTS`，不做首次访问自动建行。
model AssistantPersona {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 助手名字，≤24 字。null = 用域名（「图片助手」）。
  name String?

  /// 预设头像 id（`ASSISTANT_AVATAR_PRESET_IDS`，内联 SVG 常量，不落静态图片）。
  avatarPreset     String?
  /// 自定义头像：R2 上那张图的地址与对象键。换头像时先按 key 删旧对象再传。
  avatarUrl        String?
  avatarStorageKey String?

  /// professional / friendly / terse / custom（`ASSISTANT_PERSONA_TONES`）。
  tone       String  @default("friendly")
  /// tone = custom 时那一句话，≤80 字；其余档位为 null。
  toneCustom String?

  /// concise / standard / detailed —— 落到系统提示里是**字数区间**，不是形容词。
  verbosity String @default("standard")
  /// always / auto / direct —— 「先问我」开关的初始态 + 出卡判据。
  planMode  String @default("auto")
  /// ui / chinese / english —— 覆盖请求里的 responseLanguage。
  language  String @default("ui")

  /// 每条回复末尾给一条「下一步建议」（v2 §11.3）。默认开：默认档就是「平衡」，
  /// 而那张卡第三行写的正是「附一条下一步」。
  nextStepHint  Boolean @default(true)
  /// 优先使用创作者自己用过的说法与角色名（v2 §11.3）。默认开：用户的词本来就
  /// 是这段对话的词表，助手把「黄昏光」改叫「暖色调逆光」是在制造翻译成本。
  useMyWords    Boolean @default(true)
  /// 怎么称呼这位创作者，≤24 字。null = 用账号名。
  addressUserAs String?

  /// 三档人设（v2 §11.1）：cautious / balanced / handsOff。默认 balanced ——
  /// 上面那几列的默认值逐格等于「平衡」档（owner 2026-09-11）。
  /// NULL = 自定义 —— 用户改过某个高级项，这一份不再完全对上任何一档；
  /// 存量行同样是 NULL，读的那一跳按 `matchAssistantPersonaArchetype` 回推，
  /// ⛔ 不写迁移去改存量数据。
  /// ⛔ 不做成 Prisma 枚举：词表住 constants（同 tone / verbosity），边界校验交给 Zod。
  archetype String? @default("balanced")

  /// 输入区文本模型 chip 选的那一档（`NODE_STUDIO_ASSISTANT_ROUTE_MODELS` 的
  /// modelId）。null = 「自动」——服务端按 resolveLlmTextRoute 的优先级自己挑。
  /// ⛔ 不做成 Prisma 枚举：模型表住 constants，边界校验交给 Zod。
  routeModel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 项目规则（`docs/references/pages/assistant-shell.md` §10，拍板 23）——用户在
/// 工作里沉淀下来的一条硬约束，助手读得到、也记得回。
///
/// `scope` 为空 = 全域生效；非空时存的是 `ASSISTANT_OPERATOR_DOMAINS` 里的域 id。
/// ⛔ 不做成 Prisma 枚举：域词表住在 `constants/assistant-protocol.ts`，
/// 两处枚举必然漂移，边界校验交给 Zod。
model ProjectRule {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// null = 全域。非空时是一个域 id（image / video / lora）。
  scope  String?
  /// 规则原文，规则薄卡上逐字展示。来源名单那两种 kind 里装的是来源 id 或域名。
  text   String            @db.Text
  /// 这条规则是谁记下来的 —— 助手在对话里记的，还是用户自己写的。
  source ProjectRuleSource
  /// 普通规则 / 来源白名单 / 来源黑名单（§9.3）。存量行一律是普通规则。
  kind   ProjectRuleKind   @default(NOTE)

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, kind])
}

