#!/bin/sh
# Pre-push：推分支和推 main 一样，只查本次改动相关的部分；全量在 CI。
# 推 main 不再本机跑全量（owner 2026-11-03）：Vercel 开了 Deployment Checks，
# 生产部署等 CI 全绿才切到正式域名，红了不上线（docs/references/testing.md「闸门」）。
# husky 以 `sh -e` 执行：grep 无匹配会直接退出，所以取值处都带 `|| true`。

BASE=$(git merge-base HEAD origin/main 2>/dev/null || true)
if [ -z "$BASE" ]; then
  echo "⚠️  No origin/main merge-base; running full checks"
  npx tsc --noEmit && npm run lint && npx vitest run --maxWorkers=2 || exit 1
  exit 0
fi

CHANGED=$(git diff --name-only --diff-filter=ACMR "$BASE" HEAD)
CODE=$(echo "$CHANGED" | grep -E '^(src/|prisma/|e2e/.*\.ts$|[^/]*\.config\.(ts|mjs)$|tsconfig\.json$|package(-lock)?\.json$)' || true)

if [ -z "$CODE" ]; then
  echo "✅ Pre-push: no code changes since origin/main (docs/tools only), skipping"
  exit 0
fi

echo "🔍 Pre-push (changed since $(git rev-parse --short "$BASE")): tsc + lint + related vitest..."

# tsconfig 已开 incremental：第二次起只重查变化部分。
npx tsc --noEmit || { echo "❌ Type check failed"; exit 1; }

LINT_FILES=$(echo "$CHANGED" | grep -E '^src/.*\.(ts|tsx)$' || true)
if [ -n "$LINT_FILES" ]; then
  # shellcheck disable=SC2086
  npx eslint $LINT_FILES || { echo "❌ Lint failed"; exit 1; }
fi

# 依赖 / 测试配置变了，影响面算不准 → 全量。
if echo "$CHANGED" | grep -qE '^(package(-lock)?\.json|vitest\.config\.ts|tsconfig\.json)$'; then
  npx vitest run --maxWorkers=2 || { echo "❌ Tests failed"; exit 1; }
else
  npx vitest run --changed "$BASE" --passWithNoTests --maxWorkers=2 || { echo "❌ Tests failed"; exit 1; }
fi

echo "✅ Related checks passed (full suite runs in CI; Vercel waits for it)"
