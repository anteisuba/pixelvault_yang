{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "claude/**": false,
      "codex/**": false,
      "dependabot/**": false,
      "chore/**": false
    }
  },
  "github": {
    "silent": false
  },
  "buildCommand": "bash scripts/vercel-build.sh",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "crons": [
    {
      "path": "/api/internal/execution/sweep",
      "schedule": "0 12 * * *"
    }
  ]
}
