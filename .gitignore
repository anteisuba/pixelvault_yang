# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.coverage
__pycache__/
*.py[cod]

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma
.gstack/
.env*.local
.claude/worktrees/
.claude/settings.local.json

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/.auth/

# codex artifacts (browser profiles with LOCK files break Turbopack)
.codex-artifacts/
.codex-dev.err.log
.codex-dev.out.log
.codex/
/codex

# clerk configuration (can include secrets)
/.clerk/

# local scratch / probe outputs (e.g. fal-probe run dirs)
/tmp/
# research-connectivity-probe 的运行输出，每次跑都重写（scripts/research-connectivity-probe.mjs）
/scripts/probe-latest.json

# generated monitor outputs (model-doc-monitor snapshots/reports — regenerated, not tracked)
/artifacts/

# design-sync (claude.ai/design) — staged scripts, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/

# design canvas（design-work/）：.dc.html 画板与 canvas.json 是源文件，进仓；
# 发布用的单文件打包把整个编辑器代码内联进去（2.3MB），是构建产物，不进仓。
/design-work/*.html
!/design-work/*.dc.html

# obsidian vault config (docs/ doubles as an Obsidian vault)
docs/.obsidian/
