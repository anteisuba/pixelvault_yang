  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([pipelineId, clipIndex])
  @@index([pipelineId, clipIndex])
  @@index([status, createdAt(sort: Desc)])
}

